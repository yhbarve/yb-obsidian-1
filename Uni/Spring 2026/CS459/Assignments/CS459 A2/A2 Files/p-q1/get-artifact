#!/usr/bin/env python3
import sys
import re
from scapy.all import rdpcap, TCP

def extract_artifact(pcap_path, output_path="recovered"):
    packets = rdpcap(pcap_path)
    
    # Dictionary to ensure files are ordered correctly regardless of packet arrival order
    file_data_map = {}
    
    # Regex to find the target HTML filename from HTTP header/body chunks if needed,
    # and regex to extract all 6-digit hex color codes
    title_regex = re.compile(r"Columbia Chronicles Draft (\d+)")
    hex_regex = re.compile(r"#[0-9a-fA-F]{6}")
    
    for pkt in packets:
        if pkt.haslayer(TCP) and pkt.haslayer('Raw'):
            payload = pkt['Raw'].load.decode('utf-8', errors='ignore')
            
            # Identify if this packet belongs to our target files
            if "Columbia Chronicles Draft" in payload:
                title_match = title_regex.search(payload)
                if title_match:
                    file_idx = int(title_match.group(1))
                    
                    # Extract all 10 hex color targets from the page layout
                    hex_codes = hex_regex.findall(payload)
                    
                    # Ensure it matches our expected page structure (10 color parameters)
                    if len(hex_codes) >= 10:
                        # Slice exactly the first 10 if there are auxiliary matches
                        target_hex = hex_codes[:10]
                        
                        # Convert hex strings directly to raw byte sequences
                        byte_chunk = b""
                        for h in target_hex:
                            byte_chunk += bytes.fromhex(h.lstrip('#'))
                        
                        file_data_map[file_idx] = byte_chunk

    if not file_data_map:
        print("No matching steganographic artifacts discovered.")
        return

    print(f"Successfully extracted data chunks from {len(file_data_map)} files.")
    
    # Reconstruct the full binary sequentially from file_0 onwards
    full_payload = b""
    for idx in sorted(file_data_map.keys()):
        full_payload += file_data_map[idx]
        
    # Write the complete unfragmented file out to disk
    with open(output_path, "wb") as f:
        f.write(full_payload)
        
    print(f"Data saved to: '{output_path}'")

if __name__ == "__main__":
    pcap_input = "p-q1-capture.pcap"
    if len(sys.argv) > 1:
        pcap_input = sys.argv[1]
        
    extract_artifact(pcap_input)